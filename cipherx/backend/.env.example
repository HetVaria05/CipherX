# CipherX Environment Configuration

# MongoDB Atlas or Local Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cipherx?retryWrites=true&w=majority
MONGODB_URI=

# Optional Database Name
MONGODB_DB_NAME=cipherx

# Optional VirusTotal API key for /api/advanced-analyze
# You can also pass virustotal_api_key in the request body instead of storing it here.
VT_API_KEY=
